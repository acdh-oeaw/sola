{
	"name": "@acdh-oeaw/sola",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "26.x"
	},
	"packageManager": "pnpm@12.23.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.23.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^26.13.1",
			"onFail": "error"
		}
	},
	"scripts": {
		"analyze": "next analyze",
		"build": "next build",
		"dev": "next dev",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"prepare": "pnpm run types:generate",
		"lint:check": "oxlint --report-unused-disable-directives",
		"lint:fix": "pnpm run lint:check --fix",
		"start": "next start",
		"styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"styles:fix": "pnpm run styles:check --fix",
		"types:check": "tsc --noEmit",
		"types:generate": "next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@floating-ui/react-dom": "^2.1.6",
		"@tailwindcss/turbopack": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/react-query": "^5.108.2",
		"@tanstack/react-query-devtools": "^5.108.2",
		"clsx": "^2.1.1",
		"d3-array": "^3.2.5",
		"d3-axis": "^3.0.1",
		"d3-force": "^3.0.1",
		"d3-scale": "^4.0.3",
		"d3-selection": "^3.0.1",
		"d3-zoom": "^3.0.1",
		"next": "^16.4.6",
		"next-intl": "^4.15.3",
		"react": "^19.3.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.1",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"sharp": "^0.35.5",
		"strip-markdown": "^6.0.0",
		"tailwindcss": "^4.3.5",
		"unified": "^11.0.5",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@types/d3-array": "^3.2.2",
		"@types/d3-axis": "^3.0.6",
		"@types/d3-force": "^3.0.10",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.9",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"eslint-plugin-regexp": "^3.3.3",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2008",
		"stylelint": "^18.1.0",
		"typescript": "^7.0.2"
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	}
}
