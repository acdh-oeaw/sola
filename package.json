{
	"name": "@acdh-oeaw/sola",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "26.x"
	},
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"analyze": "BUNDLE_ANALYZER=\"enabled\" next build --no-lint",
		"build": "next build",
		"dev": "next dev",
		"dev:cms": "decap-server",
		"format:check": "prettier . \"!./@(content|public)/**\" --cache --cache-location ./.prettiercache --check",
		"format:fix": "pnpm run format:check --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "eslint . --cache",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-ci || simple-git-hooks",
		"start": "next start",
		"types:check": "tsc --noEmit",
		"validate": "run-p format:check lint:check types:check"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.2.2",
		"@next/bundle-analyzer": "^15.5.29",
		"@popperjs/core": "^2.11.8",
		"@react-aria/button": "^3.15.1",
		"@react-aria/focus": "^3.22.1",
		"@react-aria/i18n": "^3.13.1",
		"@react-aria/interactions": "^3.28.1",
		"@react-aria/listbox": "^3.16.1",
		"@react-aria/menu": "^3.22.1",
		"@react-aria/overlays": "^3.32.1",
		"@react-aria/progress": "^3.5.1",
		"@react-aria/separator": "^3.5.1",
		"@react-aria/ssr": "^3.10.1",
		"@react-aria/tabs": "^3.12.1",
		"@react-aria/textfield": "^3.19.1",
		"@react-aria/tooltip": "^3.10.1",
		"@react-aria/utils": "^3.34.1",
		"@react-stately/collections": "^3.13.1",
		"@react-stately/list": "^3.14.1",
		"@react-stately/menu": "^3.10.1",
		"@react-stately/overlays": "^3.7.1",
		"@react-stately/tabs": "^3.9.1",
		"@react-stately/tooltip": "^3.6.1",
		"@react-stately/tree": "^3.10.1",
		"@stefanprobst/netlify-cms-oauth-client": "^0.1.2",
		"@stefanprobst/next-error-boundary": "^3.0.2",
		"@stefanprobst/next-page-metadata": "^2.0.5",
		"@stefanprobst/remark-excerpt": "^2.0.2",
		"@stefanprobst/remark-extract-yaml-frontmatter": "^3.0.0",
		"@tailwindcss/typography": "^0.5.20",
		"clsx": "^2.1.1",
		"d3-array": "^3.2.5",
		"d3-axis": "^3.0.1",
		"d3-force": "^3.0.1",
		"d3-scale": "^4.0.3",
		"d3-selection": "^3.0.1",
		"d3-zoom": "^3.0.1",
		"globby": "^14.1.0",
		"next": "^15.5.29",
		"postcss": "^8.5.32",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-popper": "^2.3.0",
		"react-query": "^3.39.3",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"sharp": "^0.35.5",
		"strip-markdown": "^6.0.0",
		"tailwindcss": "^3.4.19",
		"unified": "^11.0.5",
		"unist-builder": "^4.0.0",
		"use-composed-ref": "^1.4.0",
		"xast-util-to-xml": "^4.0.0",
		"xastscript": "^4.0.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@acdh-oeaw/commitlint-config": "^2.0.0",
		"@acdh-oeaw/eslint-config": "^2.0.13",
		"@acdh-oeaw/eslint-config-next": "^2.0.23",
		"@acdh-oeaw/eslint-config-node": "^2.0.13",
		"@acdh-oeaw/eslint-config-react": "^2.0.14",
		"@acdh-oeaw/eslint-config-tailwindcss": "^2.0.11",
		"@acdh-oeaw/prettier-config": "^2.0.1",
		"@acdh-oeaw/stylelint-config": "^2.3.2",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@commitlint/cli": "^19.8.1",
		"@next/eslint-plugin-next": "^15.5.29",
		"@types/d3-array": "^3.2.2",
		"@types/d3-axis": "^3.0.1",
		"@types/d3-force": "^3.0.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.9",
		"@types/node": "^26",
		"@types/react": "^18.3.31",
		"decap-server": "^3.11.6",
		"eslint": "^9.39.5",
		"eslint-config-flat-gitignore": "^1.0.1",
		"globals": "^15.15.0",
		"lint-staged": "^15.5.2",
		"npm-run-all2": "^7.0.2",
		"prettier": "^3.10.0",
		"simple-git-hooks": "^2.14.0",
		"stylelint": "^16.26.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"commitlint": {
		"extends": "@acdh-oeaw/commitlint-config"
	},
	"lint-staged": {
		"*.@(js|ts|tsx)": [
			"eslint --cache --fix",
			"prettier --cache --cache-location ./.prettiercache --write"
		],
		"*.@(css)": [
			"stylelint --cache --fix",
			"prettier --cache --cache-location ./.prettiercache --write"
		],
		"*.!(css|js|ts|tsx),!./@(content|public)/**": "prettier --cache --cache-location ./.prettiercache --ignore-unknown --write"
	},
	"postcss": {
		"plugins": {
			"tailwindcss": {}
		}
	},
	"prettier": "@acdh-oeaw/prettier-config",
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged"
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-no-unknown": [
				true,
				{
					"ignoreAtRules": [
						"screen",
						"tailwind"
					]
				}
			],
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	}
}
