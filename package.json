{
	"name": "@acdh-oeaw/sola",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "26.x"
	},
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"analyze": "BUNDLE_ANALYZER=\"enabled\" next build --webpack",
		"build": "next build",
		"dev": "next dev",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "eslint . --cache",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-in-ci || lefthook install",
		"start": "next start",
		"types:check": "tsc --noEmit",
		"validate": "run-p format:check lint:check types:check"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.2.2",
		"@floating-ui/react-dom": "^2.1.6",
		"@next/bundle-analyzer": "^16.4.6",
		"@react-aria/button": "^3.15.1",
		"@react-aria/focus": "^3.22.1",
		"@react-aria/i18n": "^3.13.1",
		"@react-aria/interactions": "^3.28.1",
		"@react-aria/listbox": "^3.16.1",
		"@react-aria/menu": "^3.22.1",
		"@react-aria/overlays": "^3.32.1",
		"@react-aria/progress": "^3.5.1",
		"@react-aria/separator": "^3.5.1",
		"@react-aria/tabs": "^3.12.1",
		"@react-aria/textfield": "^3.19.1",
		"@react-aria/tooltip": "^3.10.1",
		"@react-aria/utils": "^3.34.1",
		"@react-stately/collections": "^3.13.1",
		"@react-stately/list": "^3.14.1",
		"@react-stately/menu": "^3.10.1",
		"@react-stately/tabs": "^3.9.1",
		"@react-stately/tooltip": "^3.6.1",
		"@react-stately/tree": "^3.10.1",
		"@react-types/listbox": "^3.8.0",
		"@react-types/menu": "^3.11.0",
		"@react-types/shared": "^3.37.0",
		"@react-types/tabs": "^3.4.0",
		"@react-types/textfield": "^3.13.0",
		"@react-types/tooltip": "^3.6.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/react-query": "^4.44.0",
		"@tanstack/react-query-devtools": "^4.44.0",
		"clsx": "^2.1.1",
		"d3-array": "^3.2.5",
		"d3-axis": "^3.0.1",
		"d3-force": "^3.0.1",
		"d3-scale": "^4.0.3",
		"d3-selection": "^3.0.1",
		"d3-zoom": "^3.0.1",
		"next": "^16.4.6",
		"postcss": "^8.5.32",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"sharp": "^0.35.5",
		"strip-markdown": "^6.0.0",
		"tailwindcss": "^4.3.5",
		"unified": "^11.0.5",
		"unist-builder": "^4.0.0",
		"xast-util-to-xml": "^4.0.0",
		"xastscript": "^4.0.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@acdh-oeaw/eslint-config": "^2.0.13",
		"@acdh-oeaw/eslint-config-node": "^2.0.13",
		"@acdh-oeaw/eslint-config-react": "^2.0.14",
		"@acdh-oeaw/stylelint-config": "^2.3.2",
		"@next/eslint-plugin-next": "^16.4.6",
		"@types/d3-array": "^3.2.2",
		"@types/d3-axis": "^3.0.6",
		"@types/d3-force": "^3.0.10",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.9",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/xast": "^2.0.4",
		"eslint": "^9.39.5",
		"eslint-config-flat-gitignore": "^1.0.1",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"globals": "^15.15.0",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^7.0.2",
		"oxfmt": "^0.78.0",
		"stylelint": "^16.26.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-no-unknown": [
				true,
				{
					"ignoreAtRules": [
						"theme",
						"source",
						"plugin"
					]
				}
			],
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	}
}
